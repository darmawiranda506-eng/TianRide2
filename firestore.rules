rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // =========================
    // ORDERS
    // =========================
    match /orders/{orderId} {

      // Penumpang hanya boleh membuat order atas nama dirinya.
      allow create: if signedIn()
        && request.resource.data.passengerId == request.auth.uid;

      // Penumpang melihat order sendiri.
      // Driver melihat order yang ditugaskan kepadanya.
      // Driver online dapat melihat order menunggu.
      allow read: if signedIn()
        && (
          resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || (
            resource.data.status == 'menunggu'
            && resource.data.driverId == null
          )
        );

      // Penumpang dapat memperbarui order miliknya.
      // Driver dapat memperbarui order yang ditugaskan kepadanya.
      // Driver dapat mengambil order yang masih menunggu.
      allow update: if signedIn()
        && (
          resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || (
            resource.data.status == 'menunggu'
            && resource.data.driverId == request.auth.uid
          )
        );

      allow delete: if false;
    }

    // =========================
    // PACKAGE ORDERS
    // =========================
    match /package_orders/{packageId} {

      // Pengirim hanya boleh membuat paket atas nama dirinya.
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid;

      // Pengirim dapat melihat paket miliknya.
      // Driver yang sudah ditugaskan dapat melihat paket.
      // Driver dapat melihat paket yang masih menunggu.
      allow read: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || (
            resource.data.status == 'menunggu'
            && resource.data.driverId == null
          )
        );

      // Pengirim dapat memperbarui paket miliknya.
      // Driver dapat memperbarui paket yang sudah ditugaskan.
      // Driver dapat mengambil paket yang masih menunggu.
      allow update: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || (
            resource.data.status == 'menunggu'
            && resource.data.driverId == request.auth.uid
          )
        );

      allow delete: if false;
    }

    // =========================
    // DRIVER REALTIME LOCATION
    // =========================
    match /drivers/{driverId} {

      // Driver hanya boleh membuat data dirinya sendiri.
      allow create: if signedIn()
        && request.auth.uid == driverId
        && request.resource.data.driverId == driverId;

      // Driver hanya boleh memperbarui data dirinya sendiri.
      allow update: if signedIn()
        && request.auth.uid == driverId
        && request.resource.data.driverId == driverId;

      // Jangan izinkan driver menghapus data lokasi.
      allow delete: if false;

      // Pembacaan lokasi driver ditangani berdasarkan
      // hubungan driver dengan order di sisi aplikasi.
      allow read: if signedIn();
    }


    // =========================
    // TOP UP REQUESTS
    // =========================
    match /topup_requests/{requestId} {

      allow create: if signedIn();

      allow read: if signedIn();

      allow update: if signedIn();

      allow delete: if false;
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      allow read, create, update: if signedIn()
        && request.auth.uid == userId;

      allow delete: if false;
    }

    // =========================
    // CHAT DRIVER <-> ADMIN
    // =========================
    match /chats/{driverId} {
      // Driver hanya boleh membaca chat miliknya.
      // Admin boleh membaca semua chat.
      allow read: if signedIn()
        && (
          request.auth.uid == driverId
          || request.auth.token.admin == true
        );

      // Driver hanya boleh membuat pesan sebagai dirinya.
      // Admin boleh membuat pesan untuk driver.
      allow create: if signedIn()
        && (
          (
            request.auth.uid == driverId
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderRole == 'driver'
          )
          ||
          (
            request.auth.token.admin == true
            && request.resource.data.senderRole == 'admin'
          )
        );

      allow update: if signedIn()
        && (
          request.auth.uid == driverId
          || request.auth.token.admin == true
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && (
            request.auth.uid == driverId
            || request.auth.token.admin == true
          );

        allow create: if signedIn()
          && (
            (
              request.auth.uid == driverId
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.senderRole == 'driver'
            )
            ||
            (
              request.auth.token.admin == true
              && request.resource.data.senderRole == 'admin'
            )
          );

        allow update: if signedIn()
          && (
            request.auth.uid == driverId
            || request.auth.token.admin == true
          );

        allow delete: if false;
      }
    }
  }
}
