rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "wy15nHSfqNSyrCLvei0Hdi05gEq2";
    }

    // =========================
    // ORDERS
    // =========================
    // =========================
    // FARE SETTINGS
    // =========================
    match /settings/fare {
      // Customer dan driver boleh membaca tarif terbaru.
      allow read: if signedIn();

      // Hanya Admin yang boleh mengubah tarif.
      allow create, update: if isAdmin();

      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.passengerId == request.auth.uid;

      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || (
            resource.data.status == 'menunggu'
            && resource.data.driverId == null
          )
        );

      allow update: if signedIn()
        && (
          isAdmin()
          || resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || (
            resource.data.status == 'menunggu'
            && request.resource.data.driverId == request.auth.uid
          )
        );

      allow delete: if false;
    }

    // =========================
    // PACKAGE ORDERS
    // =========================
    match /package_orders/{packageId} {
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid;

      allow read: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || (
            resource.data.status == 'menunggu'
            && resource.data.driverId == null
          )
        );

      allow update: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || (
            resource.data.status == 'menunggu'
            && request.resource.data.driverId == request.auth.uid
          )
        );

      allow delete: if false;
    }

    // =========================
    // DRIVER
    // =========================
    match /drivers/{driverId} {

      // Driver membuat dokumen dirinya sendiri.
      allow create: if signedIn()
        && request.auth.uid == driverId
        && request.resource.data.uid == request.auth.uid;

      // Driver mengubah datanya sendiri.
      // Admin boleh mengubah data driver, termasuk approval.
      allow update: if signedIn()
        && (
          request.auth.uid == driverId
          || isAdmin()
        );

      allow read: if signedIn()
        && (
          request.auth.uid == driverId
          || isAdmin()
          || (
            resource.data.online == true
            && resource.data.verificationStatus == 'disetujui'
          )
        );

      allow delete: if false;
    }

    // =========================
    // DRIVER LOOKUP
    // =========================
    match /driver_lookup/{driverId} {

      // Dipakai Driver Login untuk mencari email
      // berdasarkan ID Driver.
      allow read: if signedIn();

      // Hanya Driver yang membuat mapping miliknya.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.driverId == driverId;

      // Admin boleh memperbaiki mapping.
      allow update: if isAdmin();

      allow delete: if false;
    }

    // =========================
    // TOP UP
    // =========================
    match /topup_requests/{requestId} {
      allow create: if signedIn();
      allow read: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create: if signedIn()
        && request.auth.uid == userId;

      allow update: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow delete: if false;
    }

    // =========================
    // CHAT
    // =========================
    match /chats/{driverId} {

      allow read: if signedIn()
        && (
          request.auth.uid == driverId
          || isAdmin()
        );

      allow create: if signedIn()
        && (
          (
            request.auth.uid == driverId
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderRole == 'driver'
          )
          ||
          (
            isAdmin()
            && request.resource.data.senderRole == 'admin'
          )
        );

      allow update: if signedIn()
        && (
          request.auth.uid == driverId
          || isAdmin()
        );

      allow delete: if false;

      match /messages/{messageId} {

        allow read: if signedIn()
          && (
            request.auth.uid == driverId
            || isAdmin()
          );

        allow create: if signedIn()
          && (
            (
              request.auth.uid == driverId
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.senderRole == 'driver'
            )
            ||
            (
              isAdmin()
              && request.resource.data.senderRole == 'admin'
            )
          );

        allow update: if signedIn()
          && (
            request.auth.uid == driverId
            || isAdmin()
          );

        allow delete: if false;
      }
    }
    // =========================
    // ANNOUNCEMENTS / INFO
    // =========================
    match /announcements/{announcementId} {
      // Semua user yang login boleh membaca pengumuman.
      allow read: if signedIn();

      // Hanya Admin yang boleh membuat pengumuman.
      allow create: if isAdmin();

      // Hanya Admin yang boleh mengubah pengumuman.
      allow update: if isAdmin();

      // Hanya Admin yang boleh menghapus pengumuman.
      allow delete: if isAdmin();
    }

  }
}
